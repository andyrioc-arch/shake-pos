# Vercel no lee .gitignore: lo que no deba subir al bundle va aquí.
# El entorno virtual pesa cientos de MB y Vercel instala las dependencias
# desde requirements.txt durante el build, así que no hace falta.
.venv/
venv/
__pycache__/
*.pyc

# Los estáticos se regeneran en el build con collectstatic.
staticfiles/

# La base local nunca debe viajar: en producción se usa Postgres.
db.sqlite3

# Secretos locales. Vercel no lee .gitignore, así que sin esta línea el
# .env.local de la máquina se subiría al bundle.
.env*

.git/
